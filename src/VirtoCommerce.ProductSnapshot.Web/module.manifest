<?xml version="1.0" encoding="utf-8"?>
<module>
  <id>VirtoCommerce.ProductSnapshot</id>
  <version>3.1000.0</version>
  <version-tag></version-tag>

  <platformVersion>3.1016.0</platformVersion>
  <dependencies>
    <dependency id="VirtoCommerce.Orders" version="3.1005.0-alpha.1414-vcst-4768" />
    <dependency id="VirtoCommerce.XOrder" version="3.1002.0-alpha.107-vcst-4768" />
    <dependency id="VirtoCommerce.Catalog" version="3.1014.0" />
  </dependencies>

  <title>Product Snapshot</title>
  <description>The Product Snapshot module captures and stores product information at the moment an order is created.
  This ensures that customers and store operators always have access to the exact product details (prices, properties, images, descriptions)
  that were valid at the time of purchase, even if the product catalog is later modified or products are deleted.</description>

  <authors>
    <author>Konstantin Savosteev</author>
  </authors>
  <owners>
    <owner>VirtoCommerce</owner>
  </owners>

  <projectUrl>https://github.com/VirtoCommerce/vc-module-product-snapshot</projectUrl>
  <iconUrl>Modules/$(VirtoCommerce.ProductSnapshot)/Content/logo.png</iconUrl>
  <requireLicenseAcceptance>false</requireLicenseAcceptance>

  <assemblyFile>VirtoCommerce.ProductSnapshot.Web.dll</assemblyFile>
  <moduleType>VirtoCommerce.ProductSnapshot.Web.Module, VirtoCommerce.ProductSnapshot.Web</moduleType>

  <releaseNotes>First version.</releaseNotes>
  <copyright>Copyright © 2026 VirtoCommerce. All rights reserved</copyright>
  <tags>extension module</tags>
  <useFullTypeNameInSwagger>false</useFullTypeNameInSwagger>
</module>
