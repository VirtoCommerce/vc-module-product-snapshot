<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SonarQubeTestProject>false</SonarQubeTestProject>
    <NoWarn>1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="dist\**" />
    <Content Remove="dist\**" />
    <EmbeddedResource Remove="dist\**" />
    <None Remove="dist\**" />
    <!-- Admin Shell plugin: Vue sources in vue/, built into plugins/admin-shell/ -->
    <Compile Remove="vue\**" />
    <Content Remove="vue\**" />
    <EmbeddedResource Remove="vue\**" />
    <None Remove="vue\**" />
    <Content Remove="plugins\**" />
    <None Remove="plugins\**" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="Localizations\**">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VirtoCommerce.ProductSnapshot.Core\VirtoCommerce.ProductSnapshot.Core.csproj" />
    <ProjectReference Include="..\VirtoCommerce.ProductSnapshot.Data\VirtoCommerce.ProductSnapshot.Data.csproj" />
    <ProjectReference Include="..\VirtoCommerce.ProductSnapshot.Data.MySql\VirtoCommerce.ProductSnapshot.Data.MySql.csproj" />
    <ProjectReference Include="..\VirtoCommerce.ProductSnapshot.Data.PostgreSql\VirtoCommerce.ProductSnapshot.Data.PostgreSql.csproj" />
    <ProjectReference Include="..\VirtoCommerce.ProductSnapshot.Data.SqlServer\VirtoCommerce.ProductSnapshot.Data.SqlServer.csproj" />
    <ProjectReference Include="..\VirtoCommerce.ProductSnapshot.ExperienceApi\VirtoCommerce.ProductSnapshot.ExperienceApi.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AdminShellPlugin Include="plugins\**" />
  </ItemGroup>
  <Target Name="CopyCustomContentOnPublish" AfterTargets="Publish">
    <Copy SourceFiles="@(AdminShellPlugin)" DestinationFiles="$(PublishDir)\..\%(Identity)" />
  </Target>
</Project>
